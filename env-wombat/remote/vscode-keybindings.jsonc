[
  /*----- editor -----*/

  {
    // focus editor
    "key": "ctrl+d",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.closePanel", "workbench.action.focusActiveEditorGroup"],
    },
    "when": "!panelVisible",
  },
  {
    // previous tab
    "key": "ctrl+h",
    "command": "workbench.action.previousEditor",
    "when": "!sideBarFocus && !panelFocus && !auxiliaryBarFocus",
  },
  {
    // next tab
    "key": "ctrl+l",
    "command": "workbench.action.nextEditor",
    "when": "!sideBarFocus && !panelFocus && !auxiliaryBarFocus",
  },
  {
    // close active editor
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "editorFocus",
  },
  {
    // create new file
    "key": "ctrl+n",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.closePanel", "workbench.action.files.newUntitledFile"],
    },
  },
  {
    // create new terminal in editor
    "key": "ctrl+t",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.closePanel", "workbench.action.createTerminalEditor"],
    },
  },

  /*----- panel-----*/

  {
    // focus panel
    "key": "ctrl+g",
    "command": "workbench.action.togglePanel",
    "when": "!panelVisible || (panelVisible && panelMaximized)",
  },
  {
    // ensure panel is maximized
    "key": "ctrl+g",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "panelVisible && !panelMaximized",
  },
  {
    // open claude code when panel is open
    "key": "ctrl+d",
    "command": "claudeVSCodeSidebarSecondary.focus",
    "when": "panelVisible",
  },
  {
    // next panel view
    "key": "ctrl+l",
    "command": "workbench.action.nextPanelView",
    "when": "panelFocus",
  },
  {
    // previous panel view
    "key": "ctrl+h",
    "command": "workbench.action.previousPanelView",
    "when": "panelFocus",
  },

  /*----- sidebar -----*/

  {
    // focus source control
    "key": "ctrl+r",
    "command": "workbench.scm.focus",
  },
  {
    // open explorer when sidebar is open
    "key": "ctrl+e",
    "command": "workbench.view.explorer",
  },
  {
    // previous side bar view
    "key": "ctrl+h",
    "command": "workbench.action.previousSideBarView",
    "when": "sideBarFocus",
  },
  {
    // next side bar view
    "key": "ctrl+l",
    "command": "workbench.action.nextSideBarView",
    "when": "sideBarFocus",
  },

  /*----- explorer -----*/

  {
    // open file
    "key": "enter",
    "command": "list.select",
    "when": "explorerViewletFocus && !inputFocus",
  },
  {
    // new file
    "key": "a",
    "command": "explorer.newFile",
    "when": "explorerViewletFocus && !inputFocus",
  },
  {
    // new folder
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "explorerViewletFocus && !inputFocus",
  },
  {
    // rename
    "key": "r",
    "command": "renameFile",
    "when": "explorerViewletFocus && !inputFocus",
  },
  {
    // down
    "key": "j",
    "command": "list.focusDown",
    "when": "explorerViewletFocus && !inputFocus",
  },
  {
    // up
    "key": "k",
    "command": "list.focusUp",
    "when": "explorerViewletFocus && !inputFocus",
  },

  /*----- other -----*/

  {
    // signal interrupt
    "key": "shift+ctrl+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus",
  },

  /*----- windows only -----*/

  {
    // clear scrollback
    "key": "ctrl+k ctrl+k",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus",
  },

  /*----- remove -----*/

  {
    "key": "ctrl+c",
    "command": "-extension.vim_ctrl+c",
    "when": "editorTextFocus && vim.active && vim.overrideCtrlC && vim.use<C-c> && !inDebugRepl",
  },
  {
    "key": "ctrl+x",
    "command": "-extension.vim_ctrl+x",
    "when": "editorTextFocus && vim.active && vim.use<C-x> && !inDebugRepl",
  },
  {
    "key": "ctrl+a",
    "command": "-extension.vim_ctrl+a",
    "when": "editorTextFocus && vim.active && vim.use<C-a> && !inDebugRepl",
  },
  {
    "key": "ctrl+v",
    "command": "-extension.vim_ctrl+v",
    "when": "editorTextFocus && vim.active && vim.use<C-v> && !inDebugRepl",
  },
  {
    "key": "ctrl+f",
    "command": "-extension.vim_ctrl+f",
    "when": "editorTextFocus && vim.active && vim.use<C-f> && !inDebugRepl && vim.mode != 'Insert'",
  },
  {
    "key": "ctrl+w",
    "command": "-extension.vim_ctrl+w",
    "when": "editorTextFocus && vim.active && vim.use<C-w> && !inDebugRepl",
  },
  {
    "key": "ctrl+p",
    "command": "-extension.vim_ctrl+p",
    "when": "editorTextFocus && vim.active && vim.use<C-p> && !inDebugRepl || vim.active && vim.use<C-p> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-p> && !inDebugRepl && vim.mode == 'SearchInProgressMode'",
  },
  {
    "key": "ctrl+n",
    "command": "-extension.vim_ctrl+n",
    "when": "editorTextFocus && vim.active && vim.use<C-n> && !inDebugRepl || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'SearchInProgressMode'",
  },
  {
    "key": "ctrl+[",
    "command": "-extension.vim_ctrl+[",
    "when": "editorTextFocus && vim.active && vim.use<C-[> && !inDebugRepl",
  },
  {
    "key": "ctrl+6",
    "command": "-extension.vim_ctrl+6",
    "when": "editorTextFocus && vim.active && vim.use<C-6> && !inDebugRepl",
  },
  {
